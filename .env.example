# ==========================================
# CFC Tuy Chapter Web App - Environment Setup
# ==========================================

# 1. Supabase (https://supabase.com)
# Retrieve these from Project Settings -> API in your Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-server-actions-only

# 2. Google Maps (https://console.cloud.google.com/google/maps-apis)
# Retrieve your Maps JavaScript API key from Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. App Domain & Metadata
NEXT_PUBLIC_SITE_URL=https://cfctuy.online
NEXT_PUBLIC_CHAPTER_NAME=Couples For Christ - Tuy Chapter
